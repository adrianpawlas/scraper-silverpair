# Silverpair Scraper — Environment Variables
# Copy this to .env and fill in if you want to override defaults.

# Supabase credentials (required in GitHub Actions — set as secrets)
SUPABASE_URL=https://yqawmzggcgpeyaaynrjk.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Device override (default: mps on Apple Silicon, auto-detects CPU on others)
# Use "cpu" explicitly on GitHub Actions runners
DEVICE=cpu
